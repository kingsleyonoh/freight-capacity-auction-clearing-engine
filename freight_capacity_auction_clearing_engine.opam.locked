opam-version: "2.0"
name: "freight_capacity_auction_clearing_engine"
version: "0.1.0"
synopsis: "Tenant-scoped freight capacity auction clearing engine"
description:
  "Explainable, deterministic freight spot-capacity auction clearing and replay."
maintainer: "Kingsley Onoh"
authors: "Kingsley Onoh"
license: "MIT"
homepage:
  "https://github.com/kingsleyonoh/freight-capacity-auction-clearing-engine"
bug-reports:
  "https://github.com/kingsleyonoh/freight-capacity-auction-clearing-engine/issues"
depends: [
  "alcotest" {= "1.9.1" & with-test}
  "angstrom" {= "0.16.1"}
  "asn1-combinators" {= "0.3.2"}
  "astring" {= "0.8.5"}
  "base" {= "v0.17.3"}
  "base-bigarray" {= "base"}
  "base-bytes" {= "base"}
  "base-domains" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "base64" {= "3.5.2"}
  "bigarray-compat" {= "1.1.0"}
  "bigstringaf" {= "0.10.0"}
  "bos" {= "0.3.0"}
  "bstr" {= "0.0.4"}
  "ca-certs" {= "1.0.3"}
  "camlp-streams" {= "5.0.1"}
  "caqti" {= "2.3.2"}
  "caqti-driver-postgresql" {= "2.3.0"}
  "caqti-lwt" {= "2.3.2"}
  "cmdliner" {= "2.1.1"}
  "cohttp" {= "6.2.1"}
  "cohttp-lwt" {= "6.2.1"}
  "cohttp-lwt-unix" {= "6.2.1"}
  "conduit" {= "8.0.0"}
  "conduit-lwt" {= "8.0.0"}
  "conduit-lwt-unix" {= "8.0.0"}
  "conf-gmp" {= "5"}
  "conf-gmp-powm-sec" {= "4"}
  "conf-libev" {= "4-13"}
  "conf-libssl" {= "4"}
  "conf-pkg-config" {= "5"}
  "conf-postgresql" {= "2"}
  "cppo" {= "1.8.0"}
  "csexp" {= "1.5.2"}
  "cstruct" {= "6.2.0"}
  "digestif" {= "1.3.1"}
  "domain-name" {= "0.5.0"}
  "dream" {= "1.0.0~alpha7"}
  "dream-httpaf" {= "1.0.0~alpha3"}
  "dream-pure" {= "1.0.0~alpha2"}
  "dune" {= "3.24.0"}
  "dune-compiledb" {= "0.6.0"}
  "dune-configurator" {= "3.24.0"}
  "dune-private-libs" {= "3.24.0"}
  "dune-site" {= "3.24.0"}
  "duration" {= "0.3.1"}
  "dyn" {= "3.24.0"}
  "eqaf" {= "0.10"}
  "ezjsonm" {= "1.3.0"}
  "faraday" {= "0.8.2"}
  "faraday-lwt" {= "0.8.2"}
  "faraday-lwt-unix" {= "0.8.2"}
  "fmt" {= "0.11.0"}
  "fpath" {= "0.7.3"}
  "fs-io" {= "3.24.0"}
  "gmap" {= "0.3.0"}
  "graphql" {= "0.14.0"}
  "graphql-lwt" {= "0.14.0"}
  "graphql_parser" {= "0.14.0"}
  "hex" {= "1.5.0"}
  "hmap" {= "0.8.1"}
  "http" {= "6.2.1"}
  "ipaddr" {= "5.6.2"}
  "ipaddr-sexp" {= "5.6.2"}
  "jsonm" {= "1.0.2"}
  "kdf" {= "1.1.0"}
  "ke" {= "0.6"}
  "lambdasoup" {= "1.1.1"}
  "logs" {= "0.10.0"}
  "lru" {= "0.3.1"}
  "lwt" {= "5.10.1"}
  "lwt-dllist" {= "1.1.0"}
  "lwt_ppx" {= "5.9.1"}
  "lwt_ssl" {= "1.2.0"}
  "macaddr" {= "5.6.2"}
  "magic-mime" {= "1.3.1"}
  "markup" {= "1.0.3"}
  "menhir" {= "20260209"}
  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}
  "menhirLib" {= "20260209"}
  "menhirSdk" {= "20260209"}
