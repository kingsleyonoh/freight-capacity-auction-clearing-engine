{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freight-capacity-auction.local/schemas/solver-artifact-manifest-v1.schema.json",
  "title": "Freight Capacity Auction solver artifact manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "tenant_uuid",
    "clearing_job_uuid",
    "backend",
    "solver_version",
    "created_at",
    "completed_at",
    "terminal_status",
    "files"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "tenant_uuid": { "type": "string", "format": "uuid" },
    "clearing_job_uuid": { "type": "string", "format": "uuid" },
    "backend": { "enum": ["minizinc", "ortools"] },
    "solver_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+ -]{0,63}$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "terminal_status": {
      "enum": ["succeeded", "infeasible", "failed", "timed_out", "cancelled"]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "media_type", "bytes", "sha256"],
        "properties": {
          "role": {
            "enum": ["input", "model", "request", "output", "evidence", "stdout", "stderr"]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "media_type": {
            "enum": [
              "application/json",
              "application/minizinc",
              "application/octet-stream",
              "text/plain"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 104857600
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
