# Freight Capacity Auction Clearing Engine
# Copy to .env.local and fill required values for local development.
# Never commit local env files or real credentials.

# App
APP_ENV=development
APP_BASE_URL=http://localhost:8080
APP_PORT=8080
LOG_LEVEL=info
SECRET_KEY_BASE=xxxxx

# Database / Queue
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
# Repository-bound host path for local host-compute replay storage; initialize with scripts/local-storage.*.
REPLAY_STORE_PATH=./data/replays/replay.duckdb
MIGRATIONS_AUTO_RUN=false

# PostgreSQL container bootstrap (deployment-only; must match DATABASE_URL)
POSTGRES_PASSWORD=xxxxx

# Tenant Management (MANDATORY)
# Use false for managed/hosted deployments.
SELF_REGISTRATION_ENABLED=true
DEFAULT_TENANT_NAME=Default Freight Auction Tenant
DEFAULT_ADMIN_EMAIL=admin@example.com
SEED_SAMPLE_DATA=true

# Auth
AUTH_TOKEN_TTL_MINUTES=60
API_KEY_PREFIX=fca_live

# Import / Solver / Replay
MAX_CSV_UPLOAD_MB=50
DEFAULT_CURRENCY=USD
BID_LATE_GRACE_SECONDS=0
UNKNOWN_CARRIER_POLICY=reject
# Closed backend values: minizinc or ortools. Timeout range: 1..3600 seconds.
SOLVER_BACKEND=minizinc
SOLVER_TIMEOUT_SECONDS=30
# Production clearing remains solver-only; heuristic fallback is replay/local diagnostics only.
PRODUCTION_CLEARING_REQUIRES_SOLVER=true
HEURISTIC_FALLBACK_FOR_REPLAY=true
# Command name or local executable path; never include credentials.
MINIZINC_BINARY_PATH=minizinc
# Optional unless SOLVER_BACKEND=ortools; blank means not configured.
ORTOOLS_WORKER_PATH=
# Strict adapter row budget: integer from 1 through 10000000.
REPLAY_MAX_ROWS=1000000
# Must remain exactly false in every environment.
REPLAY_ALLOW_EXTERNAL_EVENTS=false

# Clearing Policy Defaults
# Finite ratio from 0 through 1; values are rejected rather than clamped.
DEFAULT_SERVICE_RISK_CAP=0.15
# Finite ratio greater than 0 through 1; values are rejected rather than clamped.
DEFAULT_MAX_CARRIER_SHARE=0.30
# Strict positive integer, maximum 8760 hours (one year).
APPROVAL_EXPIRY_HOURS=24
# Strict positive integer, maximum 36500 days (100 years).
AUDIT_RETENTION_DAYS=365
# Strict positive integer, maximum 3650 days (10 years).
SOLVER_ARTIFACT_RETENTION_DAYS=90

# Optional Notification Hub; disabled unless explicitly set to exactly true.
NOTIFICATION_HUB_ENABLED=false
# Absolute HTTP(S) URL, validated while disabled; enabled production use requires HTTPS.
NOTIFICATION_HUB_URL=http://localhost:3847
# Optional while disabled; required only when the Hub is enabled. Keep blank locally.
NOTIFICATION_HUB_API_KEY=
# Strict true/false; effective only while the Hub is enabled.
NOTIFICATION_RETRY_ENABLED=true

# Optional Workflow Automation Engine; disabled unless explicitly set to exactly true.
WORKFLOW_ENGINE_ENABLED=false
# Absolute HTTP(S) URL, validated while disabled; enabled production use requires HTTPS.
WORKFLOW_ENGINE_URL=http://localhost:8000
# Optional while disabled; required only when the Workflow Engine is enabled. Keep blank locally.
WORKFLOW_ENGINE_API_KEY=
# Optional bounded identifier; blank means no high-value approval workflow is configured.
WORKFLOW_HIGH_VALUE_APPROVAL_ID=
# Strict true/false; effective only while the Workflow Engine is enabled.
WORKFLOW_STATUS_POLLING_ENABLED=true

# Optional Webhook Ingestion Engine; disabled unless explicitly set to exactly true.
WEBHOOK_ENGINE_ENABLED=false
# Absolute HTTP(S) URL, validated while disabled; enabled production use requires HTTPS.
WEBHOOK_ENGINE_URL=http://localhost:3000
# Optional while disabled; required only when the Webhook Engine is enabled. Keep blank locally.
WEBHOOK_ENGINE_API_KEY=
# Optional abstract receiver credential; required only when the Webhook Engine is enabled. Keep blank locally.
WEBHOOK_ENGINE_RECEIVER_SECRET=

# Integrations
# Strict total outbound policy budget: integer from 1 through 300 seconds.
INTEGRATION_HTTP_TIMEOUT_SECONDS=5
# Strict true/false; defaults to true and does not change core readiness semantics.
INTEGRATION_HEALTH_CHECK_ENABLED=true

# Observability
# Optional sensitive HTTP(S) DSN; blank means disabled. Never include a real DSN here.
SENTRY_DSN=
# Optional absolute HTTP(S) collector URL; production requires HTTPS when configured.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Strict true/false; defaults to true. This flag alone does not provide a metrics endpoint.
METRICS_ENABLED=true
# Optional abstract analytics credential; blank means disabled. Never include a real key here.
POSTHOG_KEY=
# Optional absolute HTTP(S) analytics host; production requires HTTPS when configured.
# A configured key requires this host; a host without a key is inert and allowed.
POSTHOG_HOST=
